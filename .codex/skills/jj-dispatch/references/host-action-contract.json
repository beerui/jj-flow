{
  "$schema": "host-action-contract.schema.json",
  "schema_version": "jj-flow/dispatch-host-action/1.0",
  "required_app_capabilities": [
    "list_projects",
    "list_threads",
    "create_thread",
    "read_thread",
    "send_message_to_thread",
    "worktree",
    "sandbox"
  ],
  "action_types": ["CREATE_THREAD", "RECONCILE_THREAD"],
  "host_ids": ["codex-app", "grok-build"],
  "handle_kinds": ["thread", "session"],
  "host_profiles": {
    "codex-app": {
      "host_id": "codex-app",
      "handle_kind": "thread",
      "create_action": "CREATE_THREAD",
      "reconcile_action": "RECONCILE_THREAD",
      "required_capabilities": [
        "list_projects",
        "list_threads",
        "create_thread",
        "read_thread",
        "send_message_to_thread",
        "worktree",
        "sandbox"
      ],
      "capability_equivalents": {
        "list_projects": "Codex App project registry (projectId + path)",
        "list_threads": "Codex App thread listing for the bound project",
        "create_thread": "CREATE_THREAD against Codex App",
        "read_thread": "read Codex thread messages / structured receipt",
        "send_message_to_thread": "send distribution_prompt into Codex thread",
        "worktree": "write workspace path: project root (project-branch default) or exclusive worktree when isolation required",
        "sandbox": "App runtime sandbox attestation fields"
      },
      "attestation_required_fields": [
        "host_id",
        "handle_kind",
        "thread_id",
        "task_key",
        "agent_name",
        "sandbox_mode",
        "effective_sandbox_mode",
        "sandbox_evidence_ref"
      ]
    },
    "grok-build": {
      "host_id": "grok-build",
      "handle_kind": "session",
      "create_action": "CREATE_THREAD",
      "reconcile_action": "RECONCILE_THREAD",
      "required_capabilities": [
        "list_projects",
        "list_threads",
        "create_thread",
        "read_thread",
        "send_message_to_thread",
        "worktree",
        "sandbox"
      ],
      "capability_equivalents": {
        "list_projects": "control-project path + git identity registry",
        "list_threads": "local/repo Grok session index or harness session metadata",
        "create_thread": "CREATE_SESSION_TASK: declare/bind session for task_key",
        "read_thread": "structured receipt or agreed artifact path for the session",
        "send_message_to_thread": "inject distribution_prompt into the bound session with audit ref",
        "worktree": "write workspace path: project root on named branch (default) or exclusive worktree when isolation required",
        "sandbox": "bound attestation JSON (effective boundary), not model prose"
      },
      "attestation_required_fields": [
        "host_id",
        "handle_kind",
        "thread_id",
        "task_key",
        "agent_name",
        "sandbox_mode",
        "effective_sandbox_mode",
        "sandbox_evidence_ref"
      ],
      "evidence_must_declare": ["handle_kind=session"]
    }
  },
  "access_profiles": {
    "read": {
      "agent_name": "jj-workflow-reviewer",
      "sandbox_mode": "read-only",
      "environment": "project-read",
      "worktree_policy": "forbidden"
    },
    "write": {
      "agent_name": "jj-workflow-developer",
      "sandbox_mode": "workspace-write",
      "environment": "project-branch",
      "worktree_policy": "project-branch-default"
    }
  },
  "workspace_mode_policy": {
    "default_write": "project-branch",
    "description": "Default same-style: bind developer to the task named feature branch at project.path (main checkout). Exclusive worktree only when isolation is required.",
    "isolation_required_when": [
      "same project already has another active write task_key",
      "main project worktree is dirty with unrelated changes that must not be polluted",
      "user explicitly requests exclusive isolation"
    ],
    "exclusive_environment": "exclusive-worktree",
    "exclusive_worktree_policy": "required-at-bind",
    "landing_rule": "Code facts must land on a named branch tip; never leave live patches only on a detached exclusive worktree without transfer."
  },
  "actions": [
    {
      "type": "CREATE_THREAD",
      "mode": "external-write",
      "required_capabilities": ["create_thread", "sandbox"],
      "write_access_capabilities": ["worktree"]
    },
    {
      "type": "RECONCILE_THREAD",
      "mode": "read-only",
      "required_capabilities": ["list_threads", "read_thread", "sandbox"],
      "write_access_capabilities": ["worktree"]
    }
  ],
  "receipt_contract": {
    "kinds": ["TASK_RESULT", "REVIEW_RESULT"],
    "statuses": ["COMPLETED", "BLOCKED"],
    "review_outcomes": ["PASS", "NEEDS_CHANGES"]
  },
  "control_plane_contract": {
    "target_difference_decisions": ["DIRECT", "ADAPT", "SYNC", "NO_CHANGE_REQUIRED", "BLOCKED"],
    "review_finding_statuses": ["OPEN", "RESOLVED", "WAIVED"]
  }
}
