{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jj-flow/ralph-run/1.2",
  "title": "jj-flow Ralph Run Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "title",
    "phase",
    "status",
    "goal",
    "scope",
    "iteration",
    "max_iterations",
    "tasks",
    "gates",
    "capability_ids",
    "artifact_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "jj-flow/ralph-run/1.0",
        "jj-flow/ralph-run/1.1",
        "jj-flow/ralph-run/1.2"
      ]
    },
    "gate_set": {
      "type": "string",
      "enum": ["full", "lite"],
      "description": "Policy layer over the same five gates. full (default) = analyze/plan/deliver/accept/archive; lite = brief/deliver/close aliases (brief=analyze+plan, close=accept+archive) with budget.max_deliver_loops<=3. Any lite gate FAIL/BLOCKED or scope.in growth promotes to full in the same task dir."
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Hot-memory injection trace. Distinct from top-level knowledge_refs (portfolio attach).",
      "properties": {
        "memory_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^(?:task-[a-z0-9][a-z0-9-]{1,80}|RALPH-[A-Za-z0-9][A-Za-z0-9_-]{1,80})$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "ANALYZE",
        "PLAN",
        "DELIVER",
        "ACCEPT",
        "ARCHIVE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "READY_FOR_USER_TEST",
        "BLOCKED",
        "PAUSED",
        "ABANDONED",
        "COMPLETED"
      ],
      "description": "Soft lifecycle status. COMPLETED is a post-archive display/compat alias and remains resumable; ABANDONED is half-done discarded work that can resume same run_id."
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "default": 20
    },
    "intensity": {
      "type": "string",
      "enum": ["tiny", "standard", "strict"],
      "description": "Speed/quality tier. Omit on legacy runs (treated as standard)."
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_deliver_loops": { "type": "integer", "minimum": 1 },
        "max_accept_rechecks": { "type": "integer", "minimum": 1 },
        "max_same_strategy_failures": { "type": "integer", "minimum": 1 }
      }
    },
    "stagnation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patience": { "type": "integer", "minimum": 1 },
        "unchanged_count": { "type": "integer", "minimum": 0 },
        "last_signal": { "type": ["string", "null"] },
        "last_score": { "type": ["number", "null"] },
        "last_fingerprint": {
          "type": ["string", "null"],
          "description": "sha256-16 of deliver workspace fingerprint (diff paths + signal)"
        }
      }
    },
    "accept_layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mechanical": { "type": "string", "enum": ["PENDING", "PASS", "FAIL", "SKIPPED"] },
        "judgment": { "type": "string", "enum": ["PENDING", "PASS", "FAIL", "SKIPPED"] },
        "judgment_mode": { "type": "string", "enum": ["none", "review", "recheck", "adversarial_note"] },
        "recheck_count": { "type": "integer", "minimum": 0 }
      }
    },
    "gate_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "message"],
        "properties": {
          "gate": { "type": "string" },
          "class": { "type": "string", "enum": ["error", "warning", "info"] },
          "code": { "type": ["string", "null"] },
          "message": { "type": "string", "minLength": 1 },
          "waived": { "type": "boolean" },
          "at": { "type": "string" }
        }
      }
    },
    "plan_options": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional multi-path PLAN candidates for strict intensity"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "req",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TASK-"
          },
          "req": {
            "type": "string",
            "pattern": "^REQ-"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "DONE",
              "BLOCKED",
              "N/A"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyze",
        "plan",
        "deliver",
        "accept",
        "archive"
      ],
      "properties": {
        "analyze": {
          "$ref": "#/$defs/gateStatus"
        },
        "plan": {
          "$ref": "#/$defs/gateStatus"
        },
        "deliver": {
          "$ref": "#/$defs/gateStatus"
        },
        "accept": {
          "$ref": "#/$defs/gateStatus"
        },
        "archive": {
          "$ref": "#/$defs/gateStatus"
        }
      }
    },
    "intervention_needed": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "unblock"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "unblock": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "MUST_AMBIGUITY",
                "IRREVERSIBLE",
                "MISSING_SECRET",
                "USER_TEST",
                "DIRTY_WORKTREE",
                "MAX_ITERATIONS",
                "STAGNATION",
                "ACCEPT_JUDGMENT_REQUIRED",
                "HALLUCINATION_CLUSTER",
                "SCOPE_AMBIGUITY",
                "PAUSED",
                "BLOCKED",
                "ABANDONED",
                "OTHER"
              ]
            },
            "at": {
              "type": "string"
            }
          }
        }
      ]
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-"
      }
    },
    "project_key": {
      "type": ["string", "null"],
      "description": "Home-map project key for hot memory. Optional."
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyze",
        "plan",
        "acceptance",
        "progress"
      ],
      "properties": {
        "analyze": {
          "type": "string",
          "pattern": "^[^#]+$"
        },
        "plan": {
          "type": "string",
          "pattern": "^[^#]+$"
        },
        "acceptance": {
          "type": "string",
          "pattern": "^[^#]+$"
        },
        "progress": {
          "type": "string",
          "pattern": "^[^#]+$"
        },
        "findings": {
          "type": "string",
          "pattern": "^[^#]+$",
          "description": "Required on schema 1.1. Bare filename; fragments forbidden."
        },
        "intent": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[^#]+$" }
          ]
        },
        "handoff_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "dispatch_snapshot_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_review_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "ready",
            "blocked_reasons",
            "must",
            "updated_at"
          ],
          "properties": {
            "handoff_id": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "ready": {
              "type": "boolean"
            },
            "blocked_reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_head": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "working_tree": {
              "type": "string"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "must": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "do_not_port": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string",
              "enum": [
                "LITE",
                "FULL"
              ]
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "execution_readiness": {
              "type": "string"
            },
            "handoff_status": {
              "type": "string"
            }
          }
        }
      ]
    },
    "dispatch_recommendation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_path"
          ],
          "properties": {
            "snapshot_path": {
              "type": "string"
            },
            "targets_hint": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "description": "Derived operational snapshot. Null clocks stay null; never blocks ACCEPT."
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latest_review_id",
            "reviews"
          ],
          "properties": {
            "latest_review_id": {
              "type": "string",
              "minLength": 1
            },
            "task_thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviews": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "review_id",
                  "path",
                  "outcome",
                  "recorded_at"
                ],
                "properties": {
                  "review_id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "PASS",
                      "NEEDS_CHANGES",
                      "BLOCKED"
                    ]
                  },
                  "reviewed_commit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "task_thread_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "review_thread_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "recorded_at": {
                    "type": "string"
                  },
                  "fix_commit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "review_scope": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "working_tree",
                      "commit",
                      null
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "family": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "lead_role": {
              "type": [
                "string",
                "null"
              ]
            },
            "lead_repo": {
              "type": [
                "string",
                "null"
              ]
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "role",
                  "status"
                ],
                "properties": {
                  "role": {
                    "type": "string"
                  },
                  "repo": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "planned_branch": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "decision_hint": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "NOT_STARTED",
                      "READY_TO_PORT",
                      "IN_PROGRESS",
                      "DONE",
                      "BLOCKED",
                      "N/A"
                    ]
                  },
                  "known_differences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "notes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Global knowledge entry ids attached at ANALYZE/init (~/.jj-flow/knowledge or configured knowledge_root)"
    },
    "knowledge_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Human-readable summaries paired with knowledge_refs"
    },
    "host": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host_id": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "codex",
                "grok-build",
                "claude",
                "qoder",
                "other",
                null
              ]
            },
            "handle_kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "session_handle": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "export_path": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ],
      "description": "Optional host/session attestation for evaluation and recovery (codex/grok-build/...). Not a checkpoint authority."
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inline sha256 ledger of the live run tree at the latest archive event (P1c; no file copy, no archive-manifest.json).",
      "required": [
        "archived_at",
        "files"
      ],
      "properties": {
        "archived_at": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_hash": {
          "type": "string"
        }
      }
    },
    "archive_history": {
      "type": "array",
      "description": "Previous archive events (time + git HEAD + manifest hash). Appended on re-archive; the latest event lives on `archive`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "archived_at"
        ],
        "properties": {
          "archived_at": {
            "type": "string"
          },
          "head": {
            "type": [
              "string",
              "null"
            ]
          },
          "manifest_hash": {
            "type": "string"
          }
        }
      }
    },
    "last_archived_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent soft archive event (resumable; not a freeze lock)."
    },
    "last_archive_path": {
      "type": "string",
      "description": "Relative path of the live run directory after the most recent in-place archive (`.workflow/ralph/<run_id>`). Legacy 1.0 copies may still exist under `.workflow/ralph/archive/` as read-only leftovers."
    }
  },
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "N/A",
        "BLOCKED"
      ]
    }
  }
}
